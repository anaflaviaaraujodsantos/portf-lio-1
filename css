* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;

}
html {
    scroll-behavior: smooth;
}

:root {
    --primaria: #ba45c2;
    --secundaria: #7c3aed;
    --escuro:#0f172a;
    --maisescuro:rgb(130, 0, 170);
    --claro: #e2e8f0;
    --vidro: rgba(255, 255, 255, 0.1);

}

    body {
        background-color: #0f172a;
        color: var(--primaria);
    }
    
    .navegacao {
        position: fixed;
        background-color: rgba(255,255,255,0,1);
        width: 100%;
        z-index: 100;
        padding: 1,5rem;
    }

    .menu {
        font-size: 2rem;
        display: flex;
        justify-content: center;
        list-style: none;
        gap: 3rem;
    }

    .menu-link {
        text-decoration: none;
        color: var(--claro);
        font-weight: 500;
        position: relative;
        padding: 1.5rem;
    }
     
    .menu-link::after{
        content: '';
        height: 2px;
        width: 0%;
        position: absolute;
        bottom: 0%;
        left: 0%;
        background-color: #e546d8;
        transition: width 0,5s ease;
    }

    .menu-link:hover::after{
        width: 100%;

    }
    .cabecalho{
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;

    }

    .foto-perfil{
        width: 400px;
        height: 400px;
        border-radius: 50%;
        border: 4px solid var(--vidro);
    }
    .h1{
        font-size: 2rem;
        color: var(--primaria);
        font-weight: bold;
        margin: 20px;
    }

    .cabecalho-sub-titulo{
        font-size: 1.5rem;
        color: #e2e8f0;
    }

    .sobre{
        padding: 6rem 2rem;
    }
    .sobre-titulo{
    text-align: center;
    font-size: 3rem;
    color: var(--claro);
    margin-bottom: 20px;
    }
    .sobre-caixa{ 
        padding: 2rem;
        max-width: 800px;
        margin: 0 auto;
        border-radius: 16px;
        border: 1px solid var(--vidro);
        backdrop-filter: blur(10px);
        background: #0f172a;

    }
    .sobre-paragrafo{
        text-align: center;
        font-size: 1.5rem;
        color: #e546d8;

    }
.projetos{
    padding: 6rem 2rem;
}

.projetos-imagem{
   height: 80%;
    width: 50%;
    object-fit: cover;
    justify-content: center;
    display: flex;

}
.projetos-titulo{
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 50px;
}
.projeto-pet:hover{
    background: var(--vidro);
    border-radius: 16px;
    backdrop-filter: blur(5px);
    border: 1px solid var(--vidro);
    overflow: hidden;
    transition: all o.5s ease;
    cursor: pointer;
}
.projetos-caixa{
    text-align: center;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px 1fr));
    max-width: 1000px;
    margin: 0 auto;
}

.projeto-pet{
    text-align: center;
    background: #0f172a;
border-radius: 20px;
backdrop-filter: blur(5px);
border: 1px solid var(--vidro);
overflow: hidden;


}